{
  "version": 2,
  "builds": [
    {
      "src": "Multilearn/wsgi.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "50mb", "runtime": "python3.9" }
    },
    {
      "src": "build_files.sh",
      "use": "@vercel/static-build",
      "config": { "distDir": "staticfiles" }
    }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/staticfiles/$1" },
    { "src": "/(.*)", "dest": "Multilearn/wsgi.py" }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "Multilearn.settings",
    "PYTHONUNBUFFERED": "true"
  }
}